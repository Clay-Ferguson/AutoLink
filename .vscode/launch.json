// F5 builds the extension and opens test-workspace/ in an Extension Development Host window.
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run AutoLink",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/test-workspace"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "build"
    }
  ]
}
